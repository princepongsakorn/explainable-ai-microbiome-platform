# ---------- Backend (NestJS) ----------
PORT=3000

# ---------- Database (Postgres in docker-compose) ----------
DATABASE_URL=postgresql://postgres_user:postgres_pass@postgres:5432/explainable_platform_db

# ---------- Redis (Bull queue) ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# ---------- Inference service (Flask + SHAP container on same VM) ----------
# host.docker.internal resolves to host VM gateway when using --add-host
INFERENCE_SERVICE_URL=http://host.docker.internal:8080

# ---------- GCS object storage (replaces AWS S3) ----------
# Same bucket as MLflow, but under a different prefix to avoid mixing artifacts.
GCS_BUCKET=microbiome_xai_platform
GCS_PREDICTIONS_PREFIX=predictions
# Signed URL TTL in seconds (default 3600 = 1 hour).
# Requires compute SA to have roles/iam.serviceAccountTokenCreator on itself.
GCS_SIGNED_URL_TTL_SEC=3600
