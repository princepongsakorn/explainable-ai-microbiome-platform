name: curatedcrc-rf
python_env: python_env.yaml

entry_points:
  prepare:
    parameters:
      checkout_dir: {type: path, default: .upstream}
    command: "python scripts/prepare_data.py --checkout-dir {checkout_dir}"
  track_a:
    parameters:
      checkout_dir: {type: path, default: .upstream}
      max_evals: {type: int, default: 50}
      tracking_uri: {type: string, default: "http://<mlflow-host>:5000"}
    command: "python scripts/train_track_a.py --checkout-dir {checkout_dir} --max-evals {max_evals} --tracking-uri {tracking_uri}"
  track_b:
    parameters:
      checkout_dir: {type: path, default: .upstream}
    command: "python scripts/evaluate_track_b.py --checkout-dir {checkout_dir}"
